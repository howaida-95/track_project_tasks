# API prefix used by axios and MSW handlers.
# Leave unset or set to /api. Do not set an empty value on Vercel — blank env
# used to make requests hit /tasks (the SPA route) and return HTML.
VITE_API_BASE_URL=/api

# MSW is enabled by default (needed for the Vercel demo without a backend).
# Set to false only when pointing at a real API.
VITE_ENABLE_MOCKS=true
